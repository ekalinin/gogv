digraph {
	node [label="\N"];
	a	[label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD></TD><TD FIXEDSIZE="TRUE" WIDTH="1" HEIGHT="5"></TD><TD></TD></TR><TR><TD FIXEDSIZE="TRUE" WIDTH="20" HEIGHT="1"></TD><TD BGCOLOR="#000001" FIXEDSIZE="TRUE" WIDTH="40" HEIGHT="20" PORT="h"></TD><TD FIXEDSIZE="TRUE" WIDTH="20" HEIGHT="1"></TD></TR><TR><TD></TD><TD FIXEDSIZE="TRUE" WIDTH="1" HEIGHT="5"></TD><TD></TD></TR></TABLE>>,
		shape=plaintext];
	b	[label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD></TD><TD FIXEDSIZE="TRUE" WIDTH="1" HEIGHT="5"></TD><TD></TD></TR><TR><TD FIXEDSIZE="TRUE" WIDTH="20" HEIGHT="1"></TD><TD BGCOLOR="#000002" FIXEDSIZE="TRUE" WIDTH="40" HEIGHT="20" PORT="h"></TD><TD FIXEDSIZE="TRUE" WIDTH="20" HEIGHT="1"></TD></TR><TR><TD></TD><TD FIXEDSIZE="TRUE" WIDTH="1" HEIGHT="5"></TD><TD></TD></TR></TABLE>>,
		shape=plaintext];
	a:h -> b:h	[arrowhead=none,
		minlen=0];
}
